# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3-flash-preview

# MongoDB Connection String
MONGO_URI=your_mongodb_connection_string_here

# JWT Authentication Secret
JWT_SECRET=your_jwt_secret_here

# SMTP (Email) Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM=Hirebud AI <your_email@gmail.com>

# OTP Configuration
OTP_EXPIRY_MINUTES=10

# Disable signup email OTP verification (keeps auth routes the same).
# When true, `/auth/verify-otp` accepts any non-empty OTP, and `/auth/login` auto-verifies unverified users.
DISABLE_OTP=false

# Local development only: log OTP to console if SMTP fails
DEV_OTP_FALLBACK=false
